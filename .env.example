# Copy this file to .env.local and fill in your values. .env.local is not committed.

# Free API key for the CARTO base maps, request one at https://carto.com/basemaps/apikey/
# Without a key the map tiles show an "API KEY REQUIRED" watermark.
VITE_CARTO_API_KEY=

# Operator shown in the imprint. Kept out of the repository, set them as secrets for the deploy.
# A c/o or service address works as well, a P.O. box does not.
VITE_IMPRINT_NAME=
VITE_IMPRINT_STREET=
VITE_IMPRINT_CITY=
VITE_IMPRINT_EMAIL=
