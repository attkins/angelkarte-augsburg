{
  "name": "angelkarte",
  "version": "0.13.0",
  "private": true,
  "description": "Interactive map of angling day tickets in and around Augsburg",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "validate": "node scripts/validate-data.mjs",
    "due": "node scripts/due.mjs",
    "links": "node scripts/check-links.mjs",
    "access-candidates": "node scripts/access-candidates.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "changelog": "git-cliff --output CHANGELOG.md",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/vollkorn": "^5.3.0",
    "leaflet": "^1.9.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "git-cliff": "^2.14.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8",
    "nopt": "^9.0.0"
  }
}
